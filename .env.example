# Servidor local ou produção atrás de proxy HTTPS
HOST=127.0.0.1
PORT=4173

# Domínio público, com https:// e sem caminho. Habilita canonical, sitemap e indexação.
SITE_URL=

# Conta de envio. Preencha também o destinatário antes de publicar.
# Exemplo de transporte com TLS: smtps://usuario:senha@smtp.exemplo.com:465
# Para STARTTLS: smtp://usuario:senha@smtp.exemplo.com:587/?requireTLS=true
SMTP_URL=
CONTACT_FROM=
CONTACT_TO=

# Ative apenas quando o servidor estiver atrás de um proxy que sobrescreva X-Real-IP.
TRUST_PROXY=false
